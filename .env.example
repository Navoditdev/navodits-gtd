# Browser-visible project configuration. These are not account credentials.
# Configure these in Vercel before deploying the cloud-enabled version.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Never use a Supabase secret key or service_role key in a VITE_ variable.
